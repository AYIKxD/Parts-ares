<?xml version="1.0" encoding="utf-8"?>
<!-- M3 Expressive — Main settings preference screen -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
        android:key="gestures_category"
        android:title="@string/gestures">

        <Preference
            android:key="screen_gestures"
            android:summary="@string/gestures_dashboard_summary"
            android:title="@string/screen_off_gestures" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="triggers_category"
        android:title="@string/triggers_category_title">

        <SwitchPreference
            android:key="trigger_sound"
            android:summary="@string/trigger_sound_summary"
            android:title="@string/trigger_sound_title" />

        <ListPreference
            android:key="trigger_sound_type"
            android:title="@string/trigger_sound_type_title"
            android:entries="@array/trigger_sound_type_entries"
            android:entryValues="@array/trigger_sound_type_values" />

        <Preference
            android:key="game"
            android:summary="@string/gaming_apps_summary"
            android:title="@string/gaming_apps_title" />

         <Preference
            android:key="custom_trigger"
            android:summary="@string/custom_trigger_summary"
            android:title="@string/custom_trigger" />

        <Preference
            android:key="trigger_mapping_manager"
            android:title="@string/trigger_mapping_manager_title"
            android:summary="@string/trigger_mapping_manager_summary" />

        <ListPreference
            android:key="alert_slider_mode"
            android:title="@string/alert_slider_mode_title"
            android:summary="@string/alert_slider_mode_summary"
            android:entries="@array/alert_slider_mode_entries"
            android:entryValues="@array/alert_slider_mode_values"
            android:defaultValue="disabled" />

     </PreferenceCategory>

    <PreferenceCategory
        android:key="leds_category"
        android:title="@string/leds_category_title">

        <SwitchPreference
            android:key="led_disco"
            android:summary="@string/led_disco_summary"
            android:title="@string/led_disco_title" />

        <SwitchPreference android:key="led_in_games"
            android:summary="@string/led_in_games_summary"
            android:title="@string/led_in_games_title"
            android:dependency="led_disco" />

        <SwitchPreference android:key="led_in_calls"
            android:summary="@string/led_in_calls_summary"
            android:title="@string/led_in_calls_title" />

    </PreferenceCategory>

</PreferenceScreen>
