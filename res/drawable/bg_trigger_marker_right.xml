<?xml version="1.0" encoding="utf-8"?>
<!-- M3 Expressive right trigger marker — rounded square with secondary color (shape variety) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow ring — rounded square -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/m3_secondary" />
            <solid android:color="@android:color/transparent" />
            <size android:width="56dp" android:height="56dp" />
        </shape>
    </item>
    <!-- Inner fill -->
    <item android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/trigger_right_bg" />
            <size android:width="48dp" android:height="48dp" />
        </shape>
    </item>
</layer-list>
