<?xml version="1.0" encoding="utf-8"?>
<!-- M3 Expressive save button — pill shaped with tertiary color -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer ring -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="2dp" android:color="@color/m3_tertiary" />
            <solid android:color="@android:color/transparent" />
            <size android:width="56dp" android:height="56dp" />
        </shape>
    </item>
    <!-- Inner fill -->
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <solid android:color="@color/trigger_save_bg" />
            <size android:width="50dp" android:height="50dp" />
        </shape>
    </item>
</layer-list>
